/dts-v1/;

#include "rk3506.dtsi"
//#include "rk3502.dtsi"
#include "vanxoak-hd-rk3506-iot-v1.dtsi"
//#include "vanxoak-hd-rk3506-iot-rgb-800x480.dtsi"

/ {
	model = "Vanxoak RK3506B/J IOT V1 Board";
	compatible = "rockchip,rk3506-iot-v1", "rockchip,rk3506";
	
		// LED
	leds {
		compatible = "gpio-leds";
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&user_gpio_pins>;

		heart_led {
			label = "run";
			gpios = <&gpio1 RK_PB3 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
			default-state = "off";
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;


		drm_logo: drm-logo@0 {
			compatible = "rockchip,drm-logo";
			reg = <0x0 0x0>;
		};
	};

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff0a0000 console=ttyFIQ0 isolcpus=2 root=PARTUUID=614e0000-0000 rw rootwait snd_aloop.index=7 snd_aloop.use_raw_jiffies=1";
	};
};

&pinctrl {
	/* External RTK PPS: input only; userspace requests rising-edge events. */
	rtk_pps_input_cfg: rtk-pps-input-cfg {
		bias-disable;
		input-enable;
	};

	user_gpios {
		user_gpio_pins: user-gpio-pins {
			rockchip,pins = 
				/* VO_LCDC_D4 -> GPIO1_C7 */
				<1 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>,
				/* VO_LCDC_D3 -> GPIO1_D0 */
				<1 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>,
				/* VO_LCDC_D2 -> GPIO1_D1 */
				/* <1 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>, */
				/* I2C2_SCL -> GPIO0_A4 */
				<0 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>,
				/* I2C2_SDA -> GPIO0_A5 */
				<0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>,
				/* CAN1_TX -> GPIO0_B5 */
				<0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>,
				/* CAN1_RX -> GPIO0_C2 (Note: used as spi_irq_pin) */
				/* CAN0_TX -> GPIO0_C3 */
				<0 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>,
				/* CAN0_RX -> GPIO0_C4 */
				<0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>,
				/* SAI1_MCLK -> GPIO0_B0 */
				<0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>,
				/* SAI1_SCLK -> GPIO0_B1 */
				/* <0 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>; */
				/* VO_LCDC_D10 -> GPIO1_C1 */
				<1 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>,
				/* VO_LCDC_D9 -> GPIO1_C2 -> RTK_PPS */
				<1 RK_PC2 RK_FUNC_GPIO &rtk_pps_input_cfg>,
				/* VO_LCDC_D8 -> GPIO1_C3 */
				<1 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>,
				/* VO_LCDC_D7 -> GPIO1_C4 */
				<1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>,
				/* VO_LCDC_D6 -> GPIO1_C5 */
				<1 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>,
				/* VO_LCDC_D5 -> GPIO1_C6 */
				<1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>,
				/* GPIO1_C0_d */
				<1 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>,
				/* GPIO1_B7_d */
				<1 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&fspi {
	status = "disabled";
};

&mmc {
	//For eMMC
	no-sdio;
	no-sd;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	non-removable;
	mmc-hs200-1_8v;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk_pins &sdmmc_cmd_pins &sdmmc_bus4_pins>;
	status = "okay";
};

&tsadc {
	status = "okay";
};

&saradc {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io16_uart1_rx &rm_io17_uart1_tx>;
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io0_uart2_rx &rm_io2_uart2_tx>;
	status = "okay";
};

&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io15_uart3_rx &rm_io14_uart3_tx>;
	status = "okay";
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io30_uart4_rx &rm_io31_uart4_tx>;
	status = "okay";
};

&pinctrl {
	spi-slave-gpio {
		spi_irq_pin: spi-irq-pin {
			// RK_PC2 对应 GPIO0_C2
			rockchip,pins = <0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};


};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io7_spi0_csn0 &rm_io3_spi0_mosi &rm_io6_spi0_miso &rm_io1_spi0_clk &spi_irq_pin>;
	status = "okay";

	spidev@0 {
		compatible = "rockchip,spidev";
		reg = <0>;
		spi-max-frequency = <50000000>;
		status = "okay";
	};
};

/* 禁用冲突模块 */
&vop { status = "disabled"; };
&dsi_in_vop { status = "disabled"; };
&rgb_in_vop { status = "disabled"; };
&route_dsi { status = "disabled"; };
&route_rgb { status = "disabled"; };
&i2c2 { status = "disabled"; };
&can0 { status = "disabled"; };
&can1 { status = "disabled"; };
&sai1 { status = "disabled"; };

/* Linux-only internal watchdog; wdt1 and external GPIO watchdog stay unused. */
&wdt0 {
	status = "okay";
	timeout-sec = <60>;
};



