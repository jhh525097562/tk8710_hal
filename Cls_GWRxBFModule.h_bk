template <class T>
void Cls_GWRxBFModule<T>::reset()
{
    zeros(m_in, m_Antenna, m_filterLen);
    zeros(m_sigSeg, m_Antenna, m_filterLen);
    zeros(m_AH, m_Antenna);
    zeros(m_HNormal, m_Antenna);
    zeros(m_inphaseComponent, m_filterLen);
    zeros(m_orthogonalComponent, m_Antenna, m_filterLen);
    zeros(m_R, m_Antenna, m_Antenna);
    zeros(m_V, m_Antenna, m_Antenna);
    zeros(m_G, m_Antenna, m_Antenna);
    zeros(m_SDDecoder, m_Antenna, m_filterLen);
    zeros(m_S, m_Antenna, m_filterLen);
    zeros(m_tempS, m_Antenna);
    zeros(m_SDout, m_Antenna, m_ifftLen);

    m_GWRxBFModule_en = 0;
    m_in_cnt = 0;
    m_in2_finish = 0;
    m_in1_finish = 0;
    m_GWBF_finish = 0;
}

template <class T>
void Cls_GWRxBFModule<T>::go()
{
    //generate sigseg
    generate_SigSeg();
    //svd
    svd_module();
    // ifft
    ifft();
}

template <class T>
void Cls_GWRxBFModule<T>::get_output_msg(Complex<double> *out)
{

}

template <class T>
void Cls_GWRxBFModule<T>::generate_SigSeg()
{
#ifdef DUMP_RTL_IS
	fxp rtl_dump;
    	fix_set(rtl_dump ,   13,  13, FXP_US, FXP_TRN, FXP_SAT_SYM);
	rtl_dump = m_freqOffsetChGrid;
    	dump(f_fo_grid, &rtl_dump, 1, rtl_dump);
#endif
    int index = 0;
    for (int ck0 = 0; ck0 < m_Antenna; ck0++)
    {
        for (int ck1 = 0; ck1 < m_FFTLen; ck1++)
        {
            index = ck1 - m_freqOffsetChGrid;
            while (1)
            {
                if ( index >= 0 && index < m_FFTLen)
                    break;
                if(index > 0)
                    index = index - m_FFTLen;
                if(index < 0)
                    index = index + m_FFTLen;
            }
            m_in_fxp = m_in[ck0][ck1];
#ifdef DUMP_RTL_IS
            dump(file_rtl_in, &m_in_fxp, 1, m_in_fxp.I);
#endif
            m_signal1[index][ck0] = m_in_fxp;
            //LOG2DEV << index<<endl;
        }
    }

    for (int ck0 = 0; ck0 < m_Antenna; ck0++)
    {
        for (int ck1 = 0; ck1 < m_halfBL; ck1++)
        {
            m_sig_fxp = m_signal1[m_FFTLen - m_halfBL + ck1][ck0] * m_HC[ck1];
            m_sigSeg[ck0][ck1] = m_sig_fxp;
            m_sig_fxp = m_signal1[ck1][ck0] * m_HC[ck1 + m_halfBL];
            m_sigSeg[ck0][ck1 + m_halfBL] = m_sig_fxp;

//	if(ck0==0){
//	    dump(f_dbg, &m_signal1[m_FFTLen - m_halfBL + ck1][ck0], 1, m_in_fxp.I);
//	    dump(f_dbg, &m_HC[ck1], 1, m_HC_fxp.I);
//	    }
        }
    }
#ifdef DUMP_RTL_IS
    fxp rtl_dump1;
    fix_set(rtl_dump1 ,   17,  6, FXP_TC, FXP_RND, FXP_SAT_SYM);
    for(int i = 0; i < m_filterLen; i++){
        dump(file_rtl_HC, &m_HC[i], 1, rtl_dump1);
        for(int j = 0; j < m_Antenna; j++) {
	    	dump(file_rtl_sigseg, &m_sigSeg[j][i], 1, m_sig_fxp.I);
		}
    }
#endif
#ifdef DUMP_MATLAB_IS
    for (int ck0 = 0; ck0 < m_Antenna; ck0++)
    {
        for (int ck1 = 0; ck1 < 2*m_halfBL; ck1++)
        {
           sigseg << fixed<<setprecision(30) << m_sigSeg[ck0][ck1].I << "\t" << m_sigSeg[ck0][ck1].Q << endl;
        }
    }
#endif // DUMP_MATLAB_IS
    /*for(int i1 = 0; i1 < m_filterLen; i1++){
        file_o_in_Tmp1 << fixed << setprecision(26) <<m_HC[i1].I<<"\t"<<endl;
        file_o_in_Tmp1 << fixed << setprecision(26) <<m_HC[i1].Q<<"\t"<<endl;
    }*/
    /*for(int i1 = 0; i1 < m_filterLen; i1++){
        for(int i2 = 0; i2<8; i2++){
          file_o_in_Tmp1 << fixed << setprecision(26) <<m_sigSeg[i2][i1].I<<"\t"<<endl;
          file_o_in_Tmp1 << fixed << setprecision(26) <<m_sigSeg[i2][i1].Q<<"\t"<<endl;
        }
    }*/
}

template <class T>
void Cls_GWRxBFModule<T>::svd_module()
{
    int i, j, k;

    if(m_BFmode==0){
        m_AH_sum = 0;
        for(i = 0; i < m_Antenna; i++){
            m_AH_fxp = m_AH[i];
            m_AH[i] = m_AH_fxp;
    #ifdef DUMP_RTL_IS
            dump(file_rtl_ah, &m_AH_fxp, 1, m_AH_fxp.I);
    #endif
            //m_AH_sum += (m_AH[i].I * m_AH[i].I + m_AH[i].Q * m_AH[i].Q);
            m_AH_sum += (m_AH[i].power());
        }
        m_AH_sum_abs = sqrt(m_AH_sum);
        m_AH_sum_abs_frac = 1.0 / m_AH_sum_abs;
        for(i = 0; i < m_Antenna; i++){
            m_h_norm_fxp = m_AH[i] * m_AH_sum_abs_frac;
            m_HNormal[i] = m_h_norm_fxp;
    #ifdef DUMP_RTL_IS
            dump(file_rtl_h_norm, &m_h_norm_fxp, 1, m_h_norm_fxp.I);
    #endif
        }

        Complex<double> m_inphaseComponent_tmp;
        for(i = 0; i < m_filterLen; i++){
            m_inphaseComponent_tmp = 0;
            for(j = 0; j < m_Antenna; j++) {
                m_HNormal_sig_fxp = m_HNormal[j].conjug() * m_sigSeg[j][i];//24.14
                m_inphaseComponent_tmp = m_HNormal_sig_fxp.todouble() + m_inphaseComponent_tmp;
            }

            m_inphaseComponent_fxp = m_inphaseComponent_tmp;//24.16
            m_inphaseComponent[i] = m_inphaseComponent_fxp;
    #ifdef DUMP_RTL_IS
            dump(file_rtl_in_phase_i, &m_inphaseComponent_fxp.I, 1, m_inphaseComponent_fxp.I);
            dump(file_rtl_in_phase_q, &m_inphaseComponent_fxp.Q, 1, m_inphaseComponent_fxp.I);
    #endif
    //    #ifdef DUMP_MATLAB_IS
    //            is_mat_out1 <<fixed<<setprecision(30)<< m_inphaseComponent[i].I <<endl;
    //            is_mat_out1 <<fixed<<setprecision(30)<< m_inphaseComponent[i].Q <<endl;
    //    #endif
        }
        for(i = 0; i < m_filterLen; i++) {
            m_SDDecoder[0][i] = m_inphaseComponent[i];
        }
        Complex<T> temp;
        for(i = 0; i < m_filterLen; i++)
            for(j = 0; j < m_Antenna; j++) {
                //temp = m_sigSeg[j][i]- m_HNormal[j] * m_inphaseComponent[i] ;
                m_h_inphase_fxp = m_HNormal[j] * m_inphaseComponent[i];
                m_orth_fxp = m_sigSeg[j][i] -  m_h_inphase_fxp.todouble();//24.16
                m_orthogonalComponent[j][i] = m_orth_fxp;
                //LOG2DEV << temp.I << "\t" << temp.Q << endl;
    #ifdef DUMP_RTL_IS
                dump(file_rtl_orth_comp, &m_orth_fxp, 1, m_orth_fxp.I);
    #endif
            }

    #ifdef DUMP_MATLAB_IS
    //        for(i = 0; i < m_Antenna; i++){
    //            for(j = 0; j < m_filterLen; j++){
    //                is_mat_out2 <<fixed<<setprecision(30)<< m_orthogonalComponent[i][j].I <<endl;
    //                is_mat_out2 <<fixed<<setprecision(30)<< m_orthogonalComponent[i][j].Q <<endl;
    //            }
    //        }
    #endif
        /*for(int i1 = 0; i1 < m_Antenna; i1++){
            file_o_in_Tmp1 << fixed << setprecision(26) <<m_AH[i1].I<<"\t"<<endl;
            file_o_in_Tmp1 << fixed << setprecision(26) <<m_AH[i1].Q<<"\t"<<endl;
        }
        for(int i1 = 0; i1 < m_filterLen; i1++){
            file_o_in_Tmp1 << fixed << setprecision(26) <<m_inphaseComponent[i1].I<<"\t"<<endl;
            file_o_in_Tmp1 << fixed << setprecision(26) <<m_inphaseComponent[i1].Q<<"\t"<<endl;
        }
        for(int i1 = 0; i1 < m_filterLen; i1++){
            for(int i2 = 0; i2<8; i2++){
              file_o_in_Tmp1 << fixed << setprecision(26) <<m_orthogonalComponent[i2][i1].I<<"\t"<<endl;
              file_o_in_Tmp1 << fixed << setprecision(26) <<m_orthogonalComponent[i2][i1].Q<<"\t"<<endl;
            }
        }*/

        for(i = 0; i < m_Antenna; i++){
            for(j = 0; j < m_Antenna; j++){
                m_R[i][j].I = 0;
                m_R[i][j].Q = 0;
                for(k = 0; k < m_filterLen; k++){
                    m_tmp1 = m_orthogonalComponent[i][k];
                    m_tmp2 = m_orthogonalComponent[j][k].conjug();
                    m_tmp1_tmp2_fxp = m_tmp1 * m_tmp2;
                    m_R_fxp = m_tmp1_tmp2_fxp.todouble() + m_R[i][j];
                    //LOG2DEV << m_R_fxp.I << "\t" << m_R_fxp.Q << endl;
                    m_R[i][j] = m_R_fxp;
    #ifdef DUMP_RTL_IS
                    dump(file_rtl_r, &m_R_fxp, 1, m_R_fxp.I);
    #endif
                }
            }
        }

    #ifdef DUMP_MATLAB_IS
    //        for(i = 0; i < m_Antenna; i++){
    //            for(j = 0; j < m_Antenna; j++){
    //                is_mat_out3 <<fixed<<setprecision(30)<< m_R[i][j].I <<endl;
    //                is_mat_out3 <<fixed<<setprecision(30)<< m_R[i][j].Q <<endl;
    //            }
    //        }
    #endif
        //SVD
        m_svd.go(m_R);
        for(int ck0 = 0 ; ck0 < 8;ck0++)
        {
            for(int ck1 = 0 ; ck1 < 8; ck1++)
            {
                m_G[ck0][ck1] = m_svd.m_S[ck0][ck1];
                m_V[ck0][ck1] = m_svd.m_U[ck0][ck1];

#ifdef DUMP_RTL_IS
		fxp rtl_s_dump, rtl_v_dump;
		fix_set(rtl_s_dump, 27, 4, FXP_US, FXP_RND, FXP_SAT_SYM);
		fix_set(rtl_v_dump, 23, 4, FXP_TC, FXP_RND, FXP_SAT_SYM);
		if(ck0==ck1) dump(f_svd_s, &m_G[ck0][ck1], 1, rtl_s_dump);
		dump(f_svd_v, &m_V[ck0][ck1], 1, rtl_v_dump);
#endif
                //m_V[ck0][ck1] = m_svd.m_V[ck0][ck1];
                /*LOG2DEV  << m_V[ck0][ck1].I << endl;
                LOG2DEV  << m_svd.m_U[ck0][ck1].I << endl;*/
            }
            /*LOG2DEV  << m_G[ck0][ck0] << endl;*/
        }
    #ifdef DUMP_MATLAB_IS_HJH
        for(int i1 = 0; i1 < 8; i1++){
            for(int i2 = 0; i2<8; i2++){
                file_SVDIn_R << fixed << setprecision(26) <<m_R[i2][i1].I<<"\t"<<endl;
                file_SVDIn_R << fixed << setprecision(26) <<m_R[i2][i1].Q<<"\t"<<endl;
            }
        }
        for(int i1 = 0; i1 < 8; i1++){
            for(int i2 = 0; i2<8; i2++){
                file_SVDOut_G << fixed << setprecision(26) <<m_G[i2][i1]<<"\t"<<endl;
            }
        }
        for(int i1 = 0; i1 < 8; i1++){
            for(int i2 = 0; i2<8; i2++){
                file_SVDOut_V << fixed << setprecision(26) <<m_V[i2][i1].I<<"\t"<<endl;
                file_SVDOut_V << fixed << setprecision(26) <<m_V[i2][i1].Q<<"\t"<<endl;
            }
        }
    #endif

    #ifdef DUMP_MATLAB_IS
        for(i = 0; i < 8; i++){
            for(j = 0; j < 8; j++){
                R_out <<fixed<<setprecision(30)<< m_R[i][j].I <<endl;
                R_out <<fixed<<setprecision(30)<< m_R[i][j].Q <<endl;

                G_out <<fixed<<setprecision(30)<< m_G[i][j] <<endl;

                V_out <<fixed<<setprecision(30)<< m_V[i][j].I <<endl;
                V_out <<fixed<<setprecision(30)<< m_V[i][j].Q <<endl;

            }
        }
    #endif
        // svd(m_R, m_Antenna, m_G, m_V);//////////////******************************************//////////////////////////////////////
        //Add SVD C code
        for(i = 0; i < m_Antenna; i++){
            for(j = 0; j < m_filterLen; j++){
                m_S_fxp = 0.0;
                for(k = 0; k < m_Antenna; k++){
                    m_tmp1 = m_V[k][i].conjug();

                    m_tmp2 = m_orthogonalComponent[k][j];//26.16
                    m_tmp1_tmp2_fxp = m_tmp1 * m_tmp2;
                    m_S_fxp = m_tmp1_tmp2_fxp.todouble() + m_S_fxp.todouble();
                }
                m_S[i][j] = m_S_fxp;//28.18
    #ifdef DUMP_RTL_IS
            dump(file_rtl_s, &m_S_fxp, 1, m_S_fxp.I);
    #endif
            }
        }

        //double m_G_tmp[8] = {3.011124856472660e-08, 2.793562954983170e-08, 2.647267447428283e-08, 2.375626381807472e-08,
                             //2.230135376113445e-08, 2.031620193210982e-08, 1.910867290431565e-08, 1.580334720167331e-24};
        //double m_G_tmp[8] = {9.05707144489200e-07, 8.84165544058079e-07, 8.56079976494773e-07, 8.20310702333305e-07,
        //                     7.83017346211945e-07, 7.49815806368854e-07, 7.38631300152362e-07, 8.51577473205987e-23};
        for(i = 0; i < m_Antenna; i++){
            m_tempS[i] = m_G[i][i];//m_G_tmp[i]
            //m_tempS[i] = m_G_tmp[i] * 1e5; //ZH
            //LOG2DEV << m_SDout[ck0][ck1].I << endl;
        }

        for(i = 0; i < m_Antenna - 1; i++){
            if(m_tempS[i] == 0) {
                m_A = 0.0;
            }
            else {
                m_Sumtmp = 0.0;
                for(j = 0; j < m_filterLen; j++){
                    m_tmp1 = m_inphaseComponent[j];//24.16

                    m_tmp2 = m_S[i][j].conjug();//28.18
                    m_tmp1_tmp2_fxp = m_tmp1 * m_tmp2;
                    m_Sumtmp = m_Sumtmp.todouble() + m_tmp1_tmp2_fxp.todouble();//45.32
                }
                m_tmp1_tmp2_fxp = m_Sumtmp;
                //m_A = m_Sumtmp / m_tempS[i];
                m_tempS_fxp = 1 / m_tempS[i];
                m_A = m_Sumtmp * m_tempS_fxp;//20.10
    #ifdef DUMP_RTL_IS
                dump(file_rtl_sumptmp, &m_Sumtmp_fxp, 1, m_Sumtmp_fxp.I);
                dump(file_rtl_a, &m_A, 1, m_A.I);
    #endif
                //LOG2DEV << m_A.I << m_A.Q << endl;

                for(j = 0; j < m_filterLen; j++){
                    m_a_s_fxp = (m_A.todouble() * m_S[i][j].todouble());//36.26
                    m_inphaseComponent_fxp = m_inphaseComponent[j].todouble() - m_a_s_fxp.todouble();//24.16
                    m_inphaseComponent[j] = m_inphaseComponent_fxp;
                    m_SDDecoder[i + 1][j] = m_inphaseComponent[j];
#ifdef DUMP_RTL_IS
		    dump(f_dec, &m_SDDecoder[i + 1][j], 1, m_inphaseComponent_fxp.I);
#endif
                }
            }
            //LOG2DEV << m_A.I << "\t"<< m_A.Q << endl;
        }

        for(i = 0; i < m_Antenna; i++){
            for(j = 0; j < m_halfBL; j++){
                m_SDout[i][j] =  m_SDDecoder[i][j + m_halfBL];
                m_SDout[i][j + m_ifftLen - m_halfBL] =  m_SDDecoder[i][j];
            }
        }

    }else if(m_BFmode==1){
        for(i = 0; i < m_Antenna; i++){
            for(j = 0; j < m_halfBL; j++){
                m_SDout[i][j] =  m_sigSeg[i][j + m_halfBL];
                m_SDout[i][j + m_ifftLen - m_halfBL] =  m_sigSeg[i][j];
            }
        }
    }else{

    }


    /*for(int i1 = 0; i1 < m_halfBL*2; i1++){
        for(int i2 = 0; i2<7; i2++){
          file_o_in_Tmp1 << fixed << setprecision(26) <<TmpSA[i2][i1].I<<"\t"<<endl;
          file_o_in_Tmp1 << fixed << setprecision(26) <<TmpSA[i2][i1].Q<<"\t"<<endl;
        }
    }*/
    /*for(int i1 = 0; i1 < m_ifftLen; i1++){
        for(int i2 = 0; i2<8; i2++){
          file_o_in_Tmp1 << fixed << setprecision(26) <<m_SDout[i2][i1].I<<"\t"<<endl;
          file_o_in_Tmp1 << fixed << setprecision(26) <<m_SDout[i2][i1].Q<<"\t"<<endl;
        }
    }*/
#ifdef DUMP_RTL_IS
    for(int ck0 = 0; ck0 < m_Antenna; ck0++) {
        for(int ck1 = 0; ck1 < m_halfBL * 2; ck1++) {
            dump(file_rtl_sdout, &m_SDout[ck0][ck1], 1, m_inphaseComponent_fxp.I);
            //LOG2DEV << m_SDout[ck0][ck1].I << endl;
        }
    }
#endif
//int a = 1;
#ifdef DUMP_MATLAB_IS
        for(i = 0; i < m_Antenna; i++){
            for(j = 0; j < m_ifftLen; j++){
                fft_out <<fixed<<setprecision(30)<< m_SDout[i][j].I <<endl;
                fft_out <<fixed<<setprecision(30)<< m_SDout[i][j].Q <<endl;
            }
        }
#endif
}

template <class T>
void Cls_GWRxBFModule<T>::ifft()
{
    for (int ck0 = 0; ck0 < m_Antenna; ck0++)
    {
        ifft_shift(0.0, 0);
        for (int ck1 = 0; ck1 < m_ifftLen; ck1++)
        {
            m_ifftin[ck1] = m_SDout[ck0][ck1];//m_SDout[ck0][ck1].conjug();
            ifft_shift(m_SDout[ck0][ck1].todouble(), 1);
	    dump(f_dbg, &m_SDout[ck0][ck1], 1, m_inphaseComponent_fxp.I);
        }
        m_shift = shift_cal();
//	dump(f_dbg, &rtl_dump,1, rtl_dump);
        for  (int ck1 = 0; ck1 < m_ifftLen; ck1++)
        {
            m_ifftin[ck1] = m_ifftin[ck1] * DOUBLE_POW2[64 - m_shift];
//	    dump(f_dbg, &m_ifftin[ck1], 1, m_inphaseComponent_fxp.I);
	    ifft_tmp[ck0][ck1] = m_ifftin[ck1];
        }

        m_ifft.ifft_n(m_ifftin, m_SigRxOut_tmp, 1, 0, 1);
        for  (int ck1 = 0; ck1 < m_ifftLen; ck1++)
        {
            m_SigRxOut_tmp[ck1] = m_SigRxOut_tmp[ck1] * DOUBLE_POW2[64 + m_shift];
        }

        /*for (int ck1 = 0; ck1 < m_ifftLen / 2; ck1++)
        {
            m_SigRxOut[ck0][ck1] = m_SigRxOut_tmp[m_ifftLen / 2 + ck1] * m_ifftLen;//m_SigRxOut_tmp[m_ifftLen / 2 + ck1].conjug();24.16
            m_SigRxOut[ck0][m_ifftLen / 2 + ck1] = m_SigRxOut_tmp[ck1] * m_ifftLen;//m_SigRxOut_tmp[ck1].conjug();
        }*/
        for (int ck1 = 0; ck1 < m_ifftLen / 2; ck1++)
        {
            m_SigRxOut[ck0][ck1] = m_SigRxOut_tmp[m_ifftLen / 2 + ck1];//m_SigRxOut_tmp[m_ifftLen / 2 + ck1].conjug();24.16
            m_SigRxOut[ck0][m_ifftLen / 2 + ck1] = m_SigRxOut_tmp[ck1];//m_SigRxOut_tmp[ck1].conjug();
        }
    }

#ifdef DUMP_RTL_IS
    fxp rtl_dump;
    fix_set(rtl_dump ,   14,  1, FXP_TC, FXP_RND, FXP_SAT_SYM);
    for (int ck0 = 0; ck0 < m_ifftLen; ck0++)
    {
        for (int ck1 = 0; ck1 < m_Antenna; ck1++)
        {
            if(ck1==m_Antenna-1) dump(file_rtl_sdout, &ifft_tmp[ck1][ck0], 1, rtl_dump);
	    else                 dump(file_rtl_sdout, &ifft_tmp[ck1][ck0], 1, rtl_dump,0);
	}
    }
#endif
    #ifdef DUMP_MATLAB_IS_HJH
    for(int i2 = 0; i2<8; i2++){
        for(int i1 = 0; i1 < m_ifftLen; i1++){
          file_BFModuleOut << fixed << setprecision(26) <<m_SigRxOut[i2][i1].I<<"\t"<<endl;
          file_BFModuleOut << fixed << setprecision(26) <<m_SigRxOut[i2][i1].Q<<"\t"<<endl;
        }
    }
    #endif // DUMP_MATLAB_IS_HJH

#ifdef DUMP_MATLAB_IS
    for (int ck0 = 0; ck0 < m_Antenna; ck0++)
    {
        for (int ck1 = 0; ck1 < m_ifftLen; ck1++)
        {
           out << fixed<<setprecision(30) << m_SigRxOut[ck0][ck1].I << "\t" << m_SigRxOut[ck0][ck1].Q  << endl;
        }
    }
#endif
    /*for(int i1 = 0; i1 < m_ifftLen; i1++){
        for(int i2 = 0; i2<8; i2++){
          file_o_in_Tmp1 << fixed << setprecision(26) <<m_SigRxOut[i2][i1].I<<"\t"<<endl;
          file_o_in_Tmp1 << fixed << setprecision(26) <<m_SigRxOut[i2][i1].Q<<"\t"<<endl;
        }
    }*/
}

template <class T>
void Cls_GWRxBFModule<T>::ifft_shift(Complex<double> in, int status)
{
    double tmp;
    if(status == 0)
        m_max = 0;
    else {
        tmp = fabs(in.I);
        if(tmp > m_max)
            m_max = tmp;
        tmp = fabs(in.Q);
        if(tmp > m_max)
            m_max = tmp;
    }
}

template <class T>
int Cls_GWRxBFModule<T>::shift_cal()
{
    int shift = 0;
    shift = ceil(log2(m_max));
    return shift;
}
#endif
