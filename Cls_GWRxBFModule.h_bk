    fix_set(m_AH_sum_abs_frac, 18, 1, FXP_US, FXP_RND, FXP_SAT_SYM);//statistic_set(m_AH_sum_abs_frac,"m_AH_sum_abs_frac", 1, 1);
    fix_set(m_h_norm_fxp, 18, 1, FXP_TC, FXP_RND, FXP_SAT_SYM);//statistic_set(m_h_norm_fxp,"m_h_norm_fxp", 1, 1);
    fix_set(m_inphaseComponent_fxp, 24, 16, FXP_TC, FXP_RND, FXP_SAT_SYM);//statistic_set(m_inphaseComponent_fxp,"m_inphaseComponent_fxp", 1, 1);
    fix_set(m_HNormal_sig_fxp, 22, 14, FXP_TC, FXP_RND, FXP_SAT_SYM);//statistic_set(m_HNormal_sig_fxp,"m_HNormal_sig_fxp", 1, 1);
